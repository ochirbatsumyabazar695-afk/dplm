generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant — нэг ресторан = нэг tenant. Бүх өгөгдөл эндээс салбарлана.
// ---------------------------------------------------------------------------
model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique // burger-house -> /t/burger-house
  name        String
  tagline     String?  @db.Text
  description String?  @db.Text
  logoUrl     String?  @db.Text
  coverUrl    String?  @db.Text
  accentColor String   @default("#0A0A0A") // brand өнгө — UI бүхэлдээ үүнээс уншина
  phone       String?
  address     String?
  latitude    Float?
  longitude   Float?
  deliveryRadiusKm Float @default(5)
  openHours   Json?
  isTemporarilyClosed Boolean @default(false)
  openTime    String   @default("09:00")
  closeTime   String   @default("22:00")
  deliveryFee Int      @default(3000) // ₮, integer
  minOrder    Int      @default(15000)
  etaMinutes  Int      @default(35)
  rating      Float    @default(4.8)
  isActive    Boolean  @default(true)
  // Захиалгын дугаарын тоолуур. Атомаар нэмэгддэг тул зэрэг ирсэн
  // захиалгууд ижил дугаар авах боломжгүй.
  orderSeq    Int      @default(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Рестораны төрөл — монгол, итали, кафе гэх мэт.
  category   String?

  // Хүлээн авах боломжууд. Ресторан бүр хүргэлт хийх албагүй —
  // хүргэлтгүй бол хэрэглэгч зөвхөн өөрөө очиж авна.
  deliveryEnabled Boolean @default(true)
  pickupEnabled   Boolean @default(true)

  // Сүбскрипшн багц
  plan                  SubscriptionPlan @default(BASIC)
  subscriptionExpiresAt DateTime?
  monthlyFee            Int              @default(50000)

  users        User[]
  categories   Category[]
  menuItems    MenuItem[]
  orders       Order[]
  payments     Payment[]
  tables       RestaurantTable[]
  reservations Reservation[]
  reviews      Review[]
  locationPings LocationPing[]

  @@map("tenants")
}

enum SubscriptionPlan {
  BASIC // Стандарт кафе/зоогийн газар (50,000₮/сар)
  PREMIUM // Премиум Fine Dining & Захиалга (150,000₮/сар)
  FRANCHISE // Франчайз / France сүлжээ ресторан (350,000₮/сар)
}


enum TableStatus {
  AVAILABLE // сул
  OCCUPIED // хүн сууж байна
  RESERVED // захиалагдсан
  OUT_OF_SERVICE // ашиглалтад байхгүй
}

/**
 * Рестораны ширээ. `Table` нь SQL-ийн түлхүүр үг тул нэрийг тодорхой болгосон.
 */
model RestaurantTable {
  id       String      @id @default(cuid())
  tenantId String
  number   String // "A1", "12" гэх мэт
  capacity Int         @default(2)
  status   TableStatus @default(AVAILABLE)
  note     String?     @db.Text
  // QR дээр орох таамаглашгүй, бүх системд давтагдахгүй token.
  qrToken  String?     @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orders       Order[]

  // Нэг ресторан дотор ширээний дугаар давхардахгүй.
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("restaurant_tables")
}

enum ReservationStatus {
  PENDING // хүлээгдэж байна
  CONFIRMED // зөвшөөрсөн
  SEATED // ирж суусан
  COMPLETED // дууссан
  CANCELLED // цуцлагдсан
  REJECTED // ресторан татгалзсан
}

/** Ширээ захиалга. Харилцагч илгээж, ресторан хянана. */
model Reservation {
  id       String  @id @default(cuid())
  tenantId String
  tableId  String?
  userId   String? // нэвтэрсэн бол гишүүнчлэл

  customerName  String
  customerPhone String
  partySize     Int      @default(2)
  // Захиалсан огноо, цаг. Цагийг "18:30" хэлбэрээр тусад нь хадгална —
  // ресторан өдрийн цагийн хуваарьтай ажилладаг.
  reservedAt    DateTime
  reservedTime  String
  note          String?  @db.Text

  status     ReservationStatus @default(PENDING)
  reviewNote String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table  RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, reservedAt])
  @@index([tableId])
  @@map("reservations")
}

enum Role {
  DIRECTOR // рестораны эзэн / захирал
  MANAGER // менежер
  CASHIER // кассчин — захиалга, төлбөр хянана
  KITCHEN // гал тогооны ажилтан
  DRIVER // хүргэлтийн жолооч
  USER // харилцагч
}

/**
 * Платформын хэмжээний бүртгэл — нэвтрэлтийн ЦОРЫН ГАНЦ эх сурвалж.
 *
 * Хэрэглэгч нэг л удаа бүртгүүлж, дараа нь дурын ресторанд хандана.
 * Ресторан тус бүрийн профайл, эрх нь `User` (гишүүнчлэл) дээр үүснэ.
 */
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  // Verify.MN утсаар бүртгүүлсэн данс нууц үггүй.
  passwordHash String?
  name         String
  phone        String?
  // Гарах бүрд нэмэгдэнэ → хуучин refresh token-ууд хүчингүй болно.
  tokenVersion Int      @default(0)
  // Платформын админ — рестораны хүсэлтийг хянаж, зөвшөөрнө.
  // Ресторан доторх эрхээс (OWNER/MANAGER/STAFF) тусдаа ойлголт.
  isPlatformAdmin Boolean @default(false)
  isBlocked       Boolean @default(false)
  createdAt    DateTime @default(now())

  memberships        User[]
  restaurantRequests RestaurantRequest[]
  addresses          Address[]

  @@map("accounts")
}

enum RequestStatus {
  PENDING // хянагдаж байна
  APPROVED // зөвшөөрөгдсөн — ресторан үүссэн
  REJECTED // татгалзсан
}

/**
 * Ресторан нээх хүсэлт.
 *
 * Хэрэглэгч бүртгүүлсний дараа хүсэлт илгээнэ → платформын админ хянана →
 * зөвшөөрвөл `Tenant` үүсч, хүсэлт гаргагч нь тухайн рестораны OWNER болно.
 */
model RestaurantRequest {
  id        String @id @default(cuid())
  accountId String

  // Хүсэлт гаргагчийн ирүүлсэн рестораны мэдээлэл
  name        String
  slug        String
  category    String? // төрөл: монгол, итали, кафе гэх мэт
  tagline     String? @db.Text
  description String? @db.Text
  phone       String?
  email       String?
  address     String?
  openTime    String  @default("09:00")
  closeTime   String  @default("22:00")
  logoUrl     String? @db.Text
  coverUrl    String? @db.Text
  accentColor String  @default("#0A0A0A")
  note        String? @db.Text // хүсэлт гаргагчийн нэмэлт тайлбар

  // Сүбскрипшн багц
  plan       SubscriptionPlan @default(BASIC)
  monthlyFee Int              @default(50000)

  status     RequestStatus @default(PENDING)

  reviewNote String?       @db.Text // админы хариу, ялангуяа татгалзсан шалтгаан
  reviewedAt DateTime?
  // Зөвшөөрсний дараа үүссэн ресторан.
  tenantId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([status])
  @@map("restaurant_requests")
}

/**
 * Нэг данс ресторан бүрт тусдаа мөртэй — "гишүүнчлэл".
 * Эрх, профайл, захиалгын түүх нь тухайн ресторандаа үлдэнэ.
 */
model User {
  id        String   @id @default(cuid())
  tenantId  String
  accountId String
  name      String
  email     String
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  vehicleType String?
  isOnline   Boolean @default(false)
  currentLat Float?
  currentLng Float?
  lastPingAt DateTime?
  avatarUrl String?  @db.Text
  createdAt DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orders       Order[]
  deliveries   Order[]         @relation("AssignedDriver")
  payments     Payment[]
  reservations Reservation[]
  locationPings LocationPing[]
  reviews       Review[]

  @@unique([tenantId, accountId])
  @@unique([tenantId, email])
  @@index([accountId])
  @@index([tenantId])
  @@map("users")
}

model Category {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int    @default(0)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@index([tenantId])
  @@map("categories")
}

model MenuItem {
  id          String   @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?  @db.Text
  imageUrl    String?  @db.Text
  price       Int // ₮ — integer, float хэзээ ч биш
  isAvailable Boolean  @default(true)
  isPopular   Boolean  @default(false)
  prepMinutes Int      @default(15)
  calories    Int?
  tags        String   @default("") // "шинэ,цагаан хоол" — таслалаар
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("menu_items")
}

model ModifierGroup {
  id         String  @id @default(cuid())
  menuItemId String
  name       String // "Хэмжээ", "Нэмэлт"
  required   Boolean @default(false)
  maxSelect  Int     @default(1) // 1 = radio, >1 = checkbox
  sortOrder  Int     @default(0)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([menuItemId])
  @@map("modifier_groups")
}

model ModifierOption {
  id         String @id @default(cuid())
  groupId    String
  name       String
  priceDelta Int    @default(0)
  sortOrder  Int    @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("modifier_options")
}

enum OrderType {
  DELIVERY // хүргэлтээр
  PICKUP // ресторанаас өөрөө авах
  DINE_IN // QR-аар ширээнээс захиалах
}

enum OrderStatus {
  PENDING // хүлээгдэж буй
  CONFIRMED // баталгаажсан
  PREPARING // бэлтгэж буй
  READY // авахад бэлэн (очиж авах захиалгад)
  DELIVERING // хүргэлтэнд гарсан
  COMPLETED // хүргэгдсэн
  CANCELLED // цуцлагдсан
  REJECTED // ресторан татгалзсан
}

enum DeliveryStatus {
  WAITING
  READY_FOR_DELIVERY
  PICKED_UP
  ON_THE_WAY
  DELIVERED
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  orderNo       Int // tenant дотор дараалсан дугаар — харилцагчид харуулах
  // Хянах холбоосын нууц түлхүүр. orderNo дараалсан тул түүгээр
  // хандах боломжтой байвал бүх захиалгыг дарааллаар нь уншиж болно.
  trackToken    String      @unique @default(cuid())
  userId        String?
  driverId      String?
  tableId       String?
  // Хүлээн авах хэлбэр. PICKUP үед хаяг шаардлагагүй тул талбарууд хоосон.
  type          OrderType   @default(DELIVERY)
  customerName  String
  customerPhone String
  district      String?
  addressLine   String?     @db.Text
  deliveryLat   Float?
  deliveryLng   Float?
  // Хүлээн авагч жолоочид хэлэх 6 оронтой хүргэлт баталгаажуулах код.
  deliveryCode  String?
  note          String?     @db.Text
  status        OrderStatus @default(PENDING)
  deliveryStatus DeliveryStatus? @default(WAITING)
  rejectReason  String? @db.Text
  subtotal      Int
  deliveryFee   Int
  total         Int
  paymentMethod String      @default("CASH") // CASH | CARD (Stripe дараа)
  isPaid        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  confirmedAt   DateTime?
  preparingAt   DateTime?
  readyAt       DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  driver   User?       @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  table    RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]
  review   Review?
  locationPings LocationPing[]

  @@unique([tenantId, orderNo])
  @@index([tenantId, status])
  @@index([userId])
  @@index([tenantId, driverId, deliveryStatus])
  @@index([tableId])
  @@map("orders")
}

model Address {
  id        String   @id @default(cuid())
  accountId String
  label     String
  detail    String   @db.Text
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([accountId])
  @@map("addresses")
}

model LocationPing {
  id         String   @id @default(cuid())
  tenantId   String
  driverId   String
  orderId    String?
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([driverId, createdAt])
  @@index([orderId, createdAt])
  @@map("location_pings")
}

model Review {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String   @unique
  userId     String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, createdAt])
  @@map("reviews")
}

enum PaymentProvider {
  QPAY // Монголын банкны апп — QR
  WIRE // Wire — Нэгдсэн Монгол төлбөрийн Gateway
  STRIPE // олон улсын карт (нөөц сонголт)
}


enum PaymentStatus {
  PENDING // төлбөр хүлээгдэж байна
  PAID // амжилттай төлөгдсөн
  FAILED // амжилтгүй
  CANCELLED // цуцлагдсан
  REFUNDED // буцаан олгосон
}

/**
 * Онлайн төлбөрийн оролдлого бүр нэг мөр. Нэг захиалга олон оролдлоготой
 * байж болно (QPay-гээр амжилтгүй болоод Stripe-аар дахин оролдох гэх мэт),
 * тиймээс Order:Payment нь 1:N.
 *
 * Дүнг ₮-өөр INT хадгална — төслийн бусад мөнгөн талбартай ижил.
 * DECIMAL хэрэглэвэл float дугуйруулалтын эрсдэл дахин орж ирнэ.
 */
model Payment {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  userId   String?

  provider PaymentProvider
  amount   Int // ₮ — захиалгаас уншина, клиентээс ХЭЗЭЭ Ч биш
  currency String          @default("MNT")
  status   PaymentStatus   @default(PENDING)

  // QPay: invoice_id · Stripe: checkout session id
  invoiceId     String?
  // QPay: payment_id · Stripe: payment_intent id
  transactionId String?
  paymentUrl    String? @db.Text // Stripe checkout URL / QPay богино холбоос
  qrText        String? @db.Text // QPay QR-ийн түүхий текст
  qrImage       String? @db.Text // QPay QR зураг (base64)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Нэг invoice хоёр удаа бүртгэгдэхээс сэргийлнэ (webhook давхар ирж болно).
  @@unique([provider, invoiceId])
  @@index([tenantId, status])
  @@index([orderId])
  @@map("payments")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String?
  name       String // snapshot — цэс өөрчлөгдсөн ч захиалга хэвээр
  imageUrl   String? @db.Text
  unitPrice  Int
  quantity   Int
  options    String  @default("") // "Том, Нэмэлт бяслаг"
  lineTotal  Int

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
