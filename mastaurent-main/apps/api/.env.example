# MySQL холболт — өөрийн root нууц үгээ тавина
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/hool_saas"

PORT=4000
NODE_ENV=development
WEB_ORIGIN="http://localhost:5173"

# Өөрийн нэвтрэлтийн JWT түлхүүрүүд.
# Dev дээр хоосон орхиж болно. Production дээр ЗААВАЛ санамсаргүй утга:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Clerk — НЭМЭЛТ сонголт. Хоосон бол нууц үгээр нэвтрэх хэвээр ажиллана.
# https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Төлбөр ---
# QPay merchant. Sandbox-д QPay-аас merchant бүртгэл авна.
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
QPAY_BASE_URL="https://merchant-sandbox.qpay.mn/v2"

# Stripe — нөөц сонголт, дипломын демод test mode
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="mnt"

# QPay callback ирэх нийтийн хаяг.
# Локал дээр: npm run tunnel -> гарсан trycloudflare.com хаягийг энд тавина.
PUBLIC_API_URL="http://localhost:4000"
